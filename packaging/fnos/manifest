appname      = kaycftunnle
version      = 1.3.0
display_name = Kay-cftunnle
desc         = Cloudflare Tunnel 自托管管理面板：管理隧道、Ingress 规则、DNS 记录，并托管 cloudflared 连接器进程。
source       = thirdparty
platform     = all

maintainer     = EasonShu
maintainer_url = https://github.com/EasonShu

os_min_version = 1.0.0

desktop_uidir       = ui
desktop_applaunchname = kaycftunnle.Application

service_port = 8567
checkport    = true
ctl_stop     = true

changelog = 总览页新增「开始使用」一键初始化：只填 Token / 子域名 / 本地服务，自动验证凭据、选域名、建隧道、写规则下发路由并启动 cloudflared，全程一条进度日志；下发路由前会先读取隧道现有配置，不再覆盖 Cloudflare 后台手写的规则；修复总览「最近操作」不显示记录。
